<?xml version="1.0" encoding="utf-8"?>
<!--
  This project has zero NuGet package references on purpose (see the
  .csproj comment), so package sources are cleared to make `dotnet build`
  and the Docker build fully offline-capable and independent of nuget.org
  being reachable.

  If you ever add a PackageReference to the .csproj, `dotnet restore` will
  fail with a "no package sources" error until you re-enable a source,
  e.g.:
      <packageSources>
        <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
      </packageSources>
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
</configuration>
